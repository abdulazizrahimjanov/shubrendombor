        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'phone', 'password', 'pin', 'passwordHash', 'pinHash',
          'hashAlgo', 'authMigrated', 'googleEmail', 'baseSalary',
          'commissionPercent', 'hiredAt', 'storeId', 'ownerUid', 'adminUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == staffId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.phone is string && data.phone.size() <= 40 &&
        (!isCreate || (!('password' in data) && !('pin' in data))) &&
        (!('password' in data) || (data.password is string && data.password.size() <= 120)) &&
        (!('pin' in data) || (data.pin is string && data.pin.size() <= 10)) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() >= 16 && data.passwordHash.size() <= 256)) &&
        (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() >= 16 && data.pinHash.size() <= 256)) &&
        (!('hashAlgo' in data) || data.hashAlgo in ['sha256', 'pbkdf2-sha256', 'firebase-auth']) &&
        (!('authMigrated' in data) || data.authMigrated is bool) &&
        (!('googleEmail' in data) || (data.googleEmail is string && data.googleEmail.size() <= 200)) &&
        data.baseSalary is number && data.baseSalary >= 0 &&
        data.commissionPercent is number && data.commissionPercent >= 0 &&
        data.hiredAt is string && data.hiredAt.size() <= 64 &&
        hasValidStoreId(data) &&
        (isCreate ? hasAdminTenantFields(data) : hasAdminTenantFieldsUpdate(data));
    }

    function isValidStaffInvite(data, inviteId, isCreate) {
      return data.keys().hasAll([
          'id', 'staffId', 'userId', 'roleId', 'assignedStoreIds',
          'permissions', 'ownerUid', 'adminUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'staffId', 'userId', 'roleId', 'assignedStoreIds',
          'permissions', 'ownerUid', 'adminUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == inviteId &&
        data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.roleId is string && data.roleId.size() >= 1 && data.roleId.size() <= 64 &&
        data.assignedStoreIds is list && data.assignedStoreIds.size() <= 20 && (data.assignedStoreIds.size() == 0 || data.assignedStoreIds[0] is string) &&
        data.permissions is list && data.permissions.size() <= 30 && (data.permissions.size() == 0 || data.permissions[0] is string) &&
        (isCreate ? hasAdminTenantFields(data) : hasAdminTenantFieldsUpdate(data));
    }

    function isValidTarget(data, targetId, isCreate) {
      return data.keys().hasAll([
          'id', 'month', 'targetAmount', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'employeeId', 'month', 'targetAmount', 'storeId', 'ownerUid',
          'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == targetId &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 128)) &&
        data.month is string && data.month.size() <= 16 &&
        data.targetAmount is number && data.targetAmount >= 0 &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidOnlineOrder(data, orderId, isCreate) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'customerName', 'customerPhone', 'deliveryAddress',
          'deliveryMethod', 'paymentMethod', 'items', 'totalAmount', 'status',
          'storeId', 'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'orderNumber', 'customerName', 'customerPhone', 'deliveryAddress',
          'deliveryMethod', 'paymentMethod', 'items', 'totalAmount', 'status',
          'note', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == orderId &&
        data.orderNumber is string && data.orderNumber.size() <= 64 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() <= 40 &&
        data.deliveryAddress is string && data.deliveryAddress.size() <= 300 &&
        data.deliveryMethod in ['delivery', 'pickup'] &&
        data.paymentMethod in ['cash_on_delivery', 'online_placeholder'] &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 100 && data.items[0] is map &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.status in ['new', 'confirmed', 'delivered', 'canceled'] &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidAuditLog(data, auditId, isCreate) {
      return data.keys().hasAll([
          'id', 'userId', 'userName', 'action', 'entityType', 'entityId',
          'details', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'action', 'entityType', 'entityId',
          'details', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == auditId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() <= 120 &&
        data.action is string && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() <= 64 &&
        data.entityId is string && data.entityId.size() <= 128 &&
        data.details is string && data.details.size() <= 500 &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidSyncedOp(data, opId, isCreate) {
      return data.keys().hasAll([
          'id', 'opType', 'actorUid', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'opType', 'actorUid', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == opId &&
        data.opType is string && data.opType.size() <= 80 &&
        data.actorUid == request.auth.uid &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    // 4. Root Connection & Admin Collections
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /admins/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isPlatformAdmin());
      allow list: if isVerified() && (isPlatformAdmin() || resource.data.id == request.auth.uid);
      allow create: if isVerified() && isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) && (
          (isBootstrappedAdmin() && request.auth.uid == userId) || isPlatformAdmin()
        );
      allow update, delete: if false;
    }

    // 5. User Profiles (Split PII Collection Pattern)
    match /userProfiles/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isPlatformAdmin());
      allow list: if isVerified() && (isPlatformAdmin() || resource.data.id == request.auth.uid);
      allow create: if isVerified() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfileCreate(incoming(), userId);
      allow update: if isVerified() && isValidId(userId) &&
        isValidUserProfileUpdate(incoming(), userId) &&
        request.auth.uid == userId && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeWorkspaceId', 'workspaceIds', 'updatedAt'])
        );
      allow delete: if false;

      match /private/{docId} {
        allow get: if isVerified() && isValidId(userId) && isValidId(docId) && (request.auth.uid == userId || isPlatformAdmin());
        allow list: if isVerified() && (request.auth.uid == userId || isPlatformAdmin());
        allow create: if isVerified() && isValidId(userId) && isValidId(docId) &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming(), userId);
        allow update: if isVerified() && isValidId(userId) && isValidId(docId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          request.auth.uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    // 6. Workspace Root & Subcollections
    match /workspaces/{workspaceId} {
      allow get: if isVerified() && isValidId(workspaceId) && (
        isPlatformAdmin() ||
        existing().ownerUid == request.auth.uid ||
        request.auth.uid in existing().memberUids ||
        request.auth.uid in existing().adminUids ||
        isInvitedEmail(existing().invitedEmails)
      );
      allow list: if isVerified() && (
        isPlatformAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in resource.data.adminUids ||
        isInvitedEmail(resource.data.invitedEmails)
      );
      allow create: if isVerified() && isValidId(workspaceId) &&
        isValidWorkspaceCreate(incoming(), workspaceId);
      allow update: if isVerified() && isValidId(workspaceId) &&
        isValidWorkspaceUpdate(incoming(), workspaceId) && (
          // Action: Admin updates settings, roles, or invited staff
          (
            isWsAdmin(workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'memberUids', 'adminUids', 'invitedEmails', 'roles', 'settings', 'version', 'updatedAt'
            ])
          ) ||
          // Action: Invited employee claims seat by appending own UID
          (
            isInvitedEmail(existing().invitedEmails) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
            incoming().memberUids.hasAll(existing().memberUids) &&
            incoming().memberUids.size() <= existing().memberUids.size() + 1 &&
            request.auth.uid in incoming().memberUids
          )
        );
      allow delete: if isVerified() && isValidId(workspaceId) && (
        existing().ownerUid == request.auth.uid || isPlatformAdmin()
      );

      // 6a. Workspace Membership (RBAC Source of Truth)
      match /members/{memberUid} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(memberUid) && (
          isPlatformAdmin() ||
          isWsAdminRead(workspaceId) ||
          (isWsMemberRead(workspaceId) && request.auth.uid == memberUid)
        );
        allow list: if isVerified() && isValidId(workspaceId) && (
          isPlatformAdmin() ||
          isWsAdminRead(workspaceId)
        );
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(memberUid) &&
          isValidWorkspaceMemberBase(incoming(), memberUid) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          memberUid in incoming().memberUids && (
            // Workspace owner bootstrapping own membership or admin adding team member
            (
              memberUid == request.auth.uid &&
              wsDoc(workspaceId).data.ownerUid == request.auth.uid
            ) ||
            isWsAdmin(workspaceId) ||
            // Invited employee self-registering using verified admin-issued staffInvites binding
            (
              memberUid == request.auth.uid &&
              isInvitedEmail(wsDoc(workspaceId).data.invitedEmails) &&
              (
                (
                  exists(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())) &&
                  incoming().staffId == get(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())).data.staffId &&
                  incoming().roleId == get(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())).data.roleId &&
                  incoming().roleId != 'owner' &&
                  incoming().assignedStoreIds == get(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())).data.assignedStoreIds &&
                  incoming().permissions == get(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())).data.permissions &&
                  incoming().isActive == true
                ) ||
                (
                  !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/staffInvites/$(authEmailSha256())) &&
                  incoming().roleId == 'cashier' &&
                  incoming().assignedStoreIds.size() >= 1 &&
                  incoming().permissions.hasOnly(['sell', 'view_catalog', 'view_customers', 'manage_customers']) &&
                  incoming().isActive == true
                )
              )
            )
          );
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(memberUid) &&
          isValidWorkspaceMemberBase(incoming(), memberUid) &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().ownerUid == existing().ownerUid &&
          isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'staffId', 'displayName', 'roleId', 'assignedStoreIds', 'permissions', 'isActive', 'memberUids', 'updatedAt'
            ])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(memberUid) &&
          isWsAdmin(workspaceId) && memberUid != wsDoc(workspaceId).data.ownerUid;
      }

      // 6b. Admin-Only Integration Secrets
      match /privateSettings/{docId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(docId) && isWsAdminRead(workspaceId);
        allow list: if canReadAdminRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(docId) &&
          isWsAdmin(workspaceId) &&
          isValidPrivateSettingsBase(incoming(), docId) &&
          hasAdminTenantFieldsForWs(incoming(), workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(docId) &&
          isValidPrivateSettingsBase(incoming(), docId) &&
          isWsAdmin(workspaceId) &&
          hasAdminTenantFieldsUpdate(incoming()) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['integrations', 'adminUids', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(docId) && isWsAdmin(workspaceId);
      }

      // 6c. Stores & Warehouses (Shared Workspace Reference Data)
      match /stores/{storeId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(storeId) && isWsMemberRead(workspaceId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(storeId) &&
          isValidStore(incoming(), storeId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsAdmin(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(storeId) &&
          isValidStore(incoming(), storeId, false) && isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'address', 'phone', 'isActive', 'defaultWarehouseId', 'storeCode', 'color', 'memberUids', 'updatedAt'
            ])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(storeId) && isWsAdmin(workspaceId);
      }

      match /warehouses/{warehouseId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(warehouseId) && isWsMemberRead(workspaceId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(warehouseId) &&
          isValidWarehouse(incoming(), warehouseId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsAdmin(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(warehouseId) &&
          isValidWarehouse(incoming(), warehouseId, false) && isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'address', 'isMain', 'storeId', 'memberUids', 'updatedAt'
            ])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(warehouseId) && isWsAdmin(workspaceId);
      }

      // 6d. Catalog (Categories, Brands, Products: Shared Workspace Data Exchange)
      match /categories/{categoryId} {
        allow get: if canGetWorkspaceDoc(workspaceId, categoryId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(categoryId) &&
          isValidCategory(incoming(), categoryId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) && (
            hasMemberPerm(workspaceId, 'manage_products') ||
            hasMemberPerm(workspaceId, 'manage_stock')
          );
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(categoryId) &&
          isValidCategory(incoming(), categoryId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              (hasMemberPerm(workspaceId, 'manage_products') || hasMemberPerm(workspaceId, 'manage_stock')) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['nameUz', 'nameRu', 'parentId', 'sortOrder', 'memberUids', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(categoryId) &&
          isActiveWsMember(workspaceId) && (
            hasMemberPerm(workspaceId, 'manage_products') ||
            hasMemberPerm(workspaceId, 'manage_stock') ||
            isWsAdmin(workspaceId)
          );
      }

      match /brands/{brandId} {
        allow get: if canGetWorkspaceDoc(workspaceId, brandId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(brandId) &&
          isValidBrand(incoming(), brandId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_products');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(brandId) &&
          isValidBrand(incoming(), brandId, false) &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_products') && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'country', 'memberUids', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(brandId) && isWsAdmin(workspaceId);
      }

      match /products/{productId} {
        allow get: if canGetWorkspaceDoc(workspaceId, productId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(productId) &&
          isValidProduct(incoming(), productId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsMember(workspaceId) &&
          hasActiveMemberRecord(workspaceId) && (
            hasMemberPerm(workspaceId, 'manage_products') ||
            hasMemberPerm(workspaceId, 'manage_stock')
          );
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(productId) &&
          isValidProduct(incoming(), productId, false) &&
          isWsMember(workspaceId) &&
          hasActiveMemberRecord(workspaceId) && (
            (
              (hasMemberPerm(workspaceId, 'manage_products') || hasMemberPerm(workspaceId, 'manage_stock')) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'categoryId', 'brandId', 'collection', 'unit', 'description',
                'photoUrl', 'supplierId', 'tags', 'isPublishedOnline', 'variants', 'memberUids', 'updatedAt'
              ])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(productId) &&
          isWsMember(workspaceId) && (
            (hasActiveMemberRecord(workspaceId) && hasMemberPerm(workspaceId, 'manage_products')) ||
            isWsAdmin(workspaceId)
          );
      }

      // 6e. Suppliers & Inventory Operations
      match /suppliers/{supplierId} {
        allow get: if canGetWorkspaceDoc(workspaceId, supplierId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(supplierId) &&
          isValidSupplier(incoming(), supplierId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsMember(workspaceId) &&
          hasActiveMemberRecord(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(supplierId) &&
          isValidSupplier(incoming(), supplierId, false) &&
          isWsMember(workspaceId) &&
          hasActiveMemberRecord(workspaceId) && (
            (
              (hasMemberPerm(workspaceId, 'manage_stock') || hasMemberPerm(workspaceId, 'manage_finance')) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'contactName', 'phone', 'address', 'notes', 'debtBalance', 'memberUids', 'updatedAt'
              ])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(supplierId) && isWsAdmin(workspaceId);
      }

      match /stockItems/{stockItemId} {
        allow get: if canGetWorkspaceDoc(workspaceId, stockItemId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(stockItemId) &&
          isValidStockItem(incoming(), stockItemId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) && (
            isWsAdmin(workspaceId) ||
            hasMemberPerm(workspaceId, 'manage_stock') ||
            hasMemberPerm(workspaceId, 'manage_products') ||
            (canNegativeStockSetting(workspaceId) && incoming().qty <= 0)
          );
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(stockItemId) &&
          isValidStockItem(incoming(), stockItemId, false) &&
          isActiveWsMember(workspaceId) && (
            isWsAdmin(workspaceId) ||
            (
              (hasMemberPerm(workspaceId, 'manage_stock') || hasMemberPerm(workspaceId, 'refund')) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['qty', 'updatedAt'])
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['qty', 'updatedAt']) &&
              incoming().qty < existing().qty &&
              (incoming().qty >= 0 || canNegativeStockSetting(workspaceId))
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(stockItemId) &&
          isWsMember(workspaceId) && (
            (hasActiveMemberRecord(workspaceId) && hasMemberPerm(workspaceId, 'manage_products')) ||
            isWsAdmin(workspaceId)
          );
      }

      match /stockMovements/{movementId} {
        allow get: if canGetWorkspaceDoc(workspaceId, movementId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(movementId) &&
          isValidStockMovement(incoming(), movementId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) && (
            isWsAdmin(workspaceId) ||
            hasMemberPerm(workspaceId, 'manage_stock') ||
            (
              incoming().type == 'sotuv' &&
              incoming().qtyDelta < 0 &&
              (incoming().qtyAfter >= 0 || canNegativeStockSetting(workspaceId))
            ) ||
            (incoming().type == 'qaytarish' && hasMemberPerm(workspaceId, 'refund'))
          );
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(movementId) &&
          isValidStockMovement(incoming(), movementId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(movementId) && isWsAdmin(workspaceId);
      }

      match /purchaseReceipts/{receiptId} {
        allow get: if canGetWorkspaceDoc(workspaceId, receiptId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(receiptId) &&
          isValidPurchaseReceipt(incoming(), receiptId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(receiptId) &&
          isValidPurchaseReceipt(incoming(), receiptId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().paymentStatus != 'paid' &&
              (hasMemberPerm(workspaceId, 'manage_stock') || hasMemberPerm(workspaceId, 'manage_finance')) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'paymentStatus', 'note', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(receiptId) && isWsAdmin(workspaceId);
      }

      match /purchaseOrders/{poId} {
        allow get: if canGetWorkspaceDoc(workspaceId, poId);
