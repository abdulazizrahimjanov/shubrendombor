          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(transferId) &&
          isValidTransfer(incoming(), transferId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status == 'sent' &&
              hasMemberPerm(workspaceId, 'manage_stock') &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'note', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(transferId) && isWsAdmin(workspaceId);
      }

      match /writeOffs/{writeOffId} {
        allow get: if canGetWorkspaceDoc(workspaceId, writeOffId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
