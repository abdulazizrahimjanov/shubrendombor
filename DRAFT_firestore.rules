rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive & Identity Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        (
          'firebase' in request.auth.token &&
          request.auth.token.firebase is map &&
          'sign_in_provider' in request.auth.token.firebase &&
          request.auth.token.firebase.sign_in_provider == 'password' &&
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          request.auth.token.email.lower().matches('^staff\\.[0-9]{4,18}@shubrend\\.internal$')
        )
      );
    }

    function isBootstrappedAdmin() {
      return isVerified() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() in [
          'assalomu408@gmail.com',
          'assdsh993@gmail.com',
          'a1sanjar73@gmail.com',
          'a40921995@gmail.com',
          'staff.998889260404@shubrend.internal'
        ];
    }

    function isInvitedEmail(emails) {
      return 'email' in request.auth.token &&
        request.auth.token.email is string && (
        request.auth.token.email in emails ||
        request.auth.token.email.lower() in emails
      );
    }

    function authEmailSha256() {
      return hashing.sha256(request.auth.token.email.lower().toUtf8()).toHexString().lower();
    }

    function isPlatformAdmin() {
      return isVerified() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function hasValidStoreId(data) {
      return data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 128;
    }

    function hasTenantFields(data) {
      return data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.memberUids is list &&
        data.memberUids.size() >= 1 &&
        data.memberUids.size() <= 50 &&
        data.memberUids[0] is string &&
        request.auth.uid in data.memberUids &&
        data.createdBy is string &&
        data.createdBy.size() >= 1 &&
        data.createdBy.size() <= 128 &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function hasAdminTenantFieldsForWs(data, workspaceId) {
      return hasAdminTenantFields(data) &&
        data.ownerUid == wsDoc(workspaceId).data.ownerUid &&
        wsDoc(workspaceId).data.ownerUid in data.adminUids;
    }

    function hasTenantFieldsUpdate(data) {
      return data.ownerUid is string &&
        data.ownerUid == existing().ownerUid &&
        data.memberUids is list &&
        data.memberUids.size() >= 1 &&
        data.memberUids.size() <= 50 &&
        data.memberUids[0] is string &&
        data.createdBy is string &&
        data.createdBy == existing().createdBy &&
        data.createdAt == existing().createdAt &&
        data.updatedAt == request.time;
    }

    function hasAdminTenantFields(data) {
      return data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.adminUids is list &&
        data.adminUids.size() >= 1 &&
        data.adminUids.size() <= 20 &&
        data.adminUids[0] is string &&
        request.auth.uid in data.adminUids &&
        data.createdBy is string &&
        data.createdBy.size() >= 1 &&
        data.createdBy.size() <= 128 &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function hasAdminTenantFieldsUpdate(data) {
      return data.ownerUid is string &&
        data.ownerUid == existing().ownerUid &&
        data.adminUids is list &&
        data.adminUids.size() >= 1 &&
        data.adminUids.size() <= 20 &&
        data.adminUids[0] is string &&
        data.createdBy is string &&
        data.createdBy == existing().createdBy &&
        data.createdAt == existing().createdAt &&
        data.updatedAt == request.time;
    }

    // Master Gate Workspace Relational Helpers
    // Write paths use getAfter/existsAfter for batched atomicity; read paths use get/exists.
    function wsDoc(workspaceId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function wsExists(workspaceId) {
      return existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function wsReadDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function wsReadExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isWsMember(workspaceId) {
      return isVerified() && wsExists(workspaceId) && (
        wsDoc(workspaceId).data.ownerUid == request.auth.uid ||
        request.auth.uid in wsDoc(workspaceId).data.memberUids ||
        request.auth.uid in wsDoc(workspaceId).data.adminUids
      );
    }

    function isWsMemberRead(workspaceId) {
      return isVerified() && wsReadExists(workspaceId) && (
        wsReadDoc(workspaceId).data.ownerUid == request.auth.uid ||
        request.auth.uid in wsReadDoc(workspaceId).data.memberUids ||
        request.auth.uid in wsReadDoc(workspaceId).data.adminUids
      );
    }

    function memberDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function hasActiveMemberRecord(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        memberDoc(workspaceId).data.isActive == true;
    }

    function isWsAdmin(workspaceId) {
      return isVerified() && wsExists(workspaceId) && (
        isPlatformAdmin() ||
        wsDoc(workspaceId).data.ownerUid == request.auth.uid ||
        request.auth.uid in wsDoc(workspaceId).data.adminUids ||
        (
          hasActiveMemberRecord(workspaceId) &&
          memberDoc(workspaceId).data.roleId in ['owner', 'admin']
        )
      );
    }

    function isWsAdminRead(workspaceId) {
      return isVerified() && wsReadExists(workspaceId) && (
        isPlatformAdmin() ||
        wsReadDoc(workspaceId).data.ownerUid == request.auth.uid ||
        request.auth.uid in wsReadDoc(workspaceId).data.adminUids ||
        (
          hasActiveMemberRecord(workspaceId) &&
          memberDoc(workspaceId).data.roleId in ['owner', 'admin']
        )
      );
    }

    function canMemberStore(workspaceId, storeId) {
      return isWsAdmin(workspaceId) || (
        hasActiveMemberRecord(workspaceId) &&
        storeId is string &&
        memberDoc(workspaceId).data.assignedStoreIds.size() > 0 &&
        storeId in memberDoc(workspaceId).data.assignedStoreIds
      );
    }

    function hasMemberPerm(workspaceId, perm) {
      return isWsAdmin(workspaceId) || (
        hasActiveMemberRecord(workspaceId) &&
        perm in memberDoc(workspaceId).data.permissions
      );
    }

    function isActiveWsMember(workspaceId) {
      return isWsMember(workspaceId) && (
        isWsAdmin(workspaceId) ||
        hasActiveMemberRecord(workspaceId)
      );
    }

    function canNegativeStockSetting(workspaceId) {
      return wsDoc(workspaceId).data.settings is map &&
        'allowNegativeStock' in wsDoc(workspaceId).data.settings &&
        wsDoc(workspaceId).data.settings.allowNegativeStock == true;
    }

    function canReadRow(data) {
      return isVerified() && (
        isPlatformAdmin() ||
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.memberUids
      );
    }

    function canReadWorkspaceRow(workspaceId, data) {
      return isVerified() && isValidId(workspaceId) && (
        isPlatformAdmin() ||
        isWsAdminRead(workspaceId) ||
        (
          isWsMemberRead(workspaceId) &&
          hasActiveMemberRecord(workspaceId)
        ) ||
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.memberUids
      );
    }

    // Strict Branch-Isolated Read Gates (enforced on BOTH get and list)
    // Allows existence checks (`resource == null`) for active workspace members in transactions/idempotency probes.
    function canGetStoreDoc(workspaceId, docId) {
      return isVerified() && isValidId(workspaceId) && isValidId(docId) && (
        isPlatformAdmin() ||
        isWsAdminRead(workspaceId) ||
        (
          isWsMemberRead(workspaceId) &&
          hasActiveMemberRecord(workspaceId) && (
            resource == null || (
              resource.data.storeId is string &&
              memberDoc(workspaceId).data.assignedStoreIds.size() > 0 &&
              resource.data.storeId in memberDoc(workspaceId).data.assignedStoreIds
            )
          )
        )
      );
    }

    // Shared Workspace Collection Read Gate (e.g. products, accounts, customers, suppliers, promos)
    function canGetWorkspaceDoc(workspaceId, docId) {
      return isVerified() && isValidId(workspaceId) && isValidId(docId) && (
        isPlatformAdmin() ||
        isWsAdminRead(workspaceId) ||
        (
          isWsMemberRead(workspaceId) &&
          hasActiveMemberRecord(workspaceId)
        )
      );
    }

    function canReadStoreRow(workspaceId, data) {
      return isVerified() && isValidId(workspaceId) && (
        isPlatformAdmin() ||
        isWsAdminRead(workspaceId) ||
        (
          isWsMemberRead(workspaceId) &&
          hasActiveMemberRecord(workspaceId) &&
          data.storeId is string &&
          memberDoc(workspaceId).data.assignedStoreIds.size() > 0 &&
          data.storeId in memberDoc(workspaceId).data.assignedStoreIds
        )
      );
    }

    function canReadAdminRow(workspaceId, data) {
      return isVerified() && isValidId(workspaceId) && (
        isPlatformAdmin() ||
        isWsAdminRead(workspaceId) ||
        (
          data.ownerUid == request.auth.uid ||
          request.auth.uid in data.adminUids
        )
      );
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'createdAt']) &&
        data.id == userId &&
        data.email is string &&
        data.email.size() <= 200 &&
        data.createdAt == request.time;
    }

    function isValidUserProfileCreate(data, userId) {
      return data.keys().hasAll(['id', 'displayName', 'activeWorkspaceId', 'workspaceIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'activeWorkspaceId', 'workspaceIds', 'createdAt', 'updatedAt']) &&
        data.id == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.activeWorkspaceId is string && data.activeWorkspaceId.size() <= 128 &&
        data.workspaceIds is list && data.workspaceIds.size() <= 20 &&
        (data.workspaceIds.size() == 0 || data.workspaceIds[0] is string) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidUserProfileUpdate(data, userId) {
      return data.keys().hasAll(['id', 'displayName', 'activeWorkspaceId', 'workspaceIds', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'activeWorkspaceId', 'workspaceIds', 'createdAt', 'updatedAt']) &&
        data.id == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.activeWorkspaceId is string && data.activeWorkspaceId.size() <= 128 &&
        data.workspaceIds is list && data.workspaceIds.size() <= 20 &&
        (data.workspaceIds.size() == 0 || data.workspaceIds[0] is string) &&
        (!('createdAt' in existing()) || data.createdAt == existing().createdAt) &&
        data.updatedAt == request.time;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['id', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'updatedAt']) &&
        data.id == userId &&
        data.email is string && data.email.size() <= 200 &&
        data.updatedAt == request.time;
    }

    function isValidWorkspaceBase(data, workspaceId) {
      return data.keys().hasAll([
          'id', 'name', 'ownerUid', 'ownerEmail', 'memberUids',
          'adminUids', 'invitedEmails', 'roles', 'settings', 'version',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'ownerUid', 'ownerEmail', 'memberUids',
          'adminUids', 'invitedEmails', 'roles', 'settings', 'version',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == workspaceId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerEmail is string && data.ownerEmail.size() <= 200 &&
        data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string &&
        data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 20 && data.adminUids[0] is string &&
        data.invitedEmails is list && data.invitedEmails.size() <= 50 && (data.invitedEmails.size() == 0 || data.invitedEmails[0] is string) &&
        data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 20 && data.roles[0] is map &&
        data.settings is map &&
        data.version is number && data.version >= 1;
    }

    function isValidWorkspaceCreate(data, workspaceId) {
      return isValidWorkspaceBase(data, workspaceId) &&
        data.ownerUid == request.auth.uid &&
        request.auth.uid in data.memberUids &&
        request.auth.uid in data.adminUids &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidWorkspaceUpdate(data, workspaceId) {
      return isValidWorkspaceBase(data, workspaceId) &&
        data.ownerUid == existing().ownerUid &&
        data.createdAt == existing().createdAt &&
        data.updatedAt == request.time;
    }

    function isValidWorkspaceMemberBase(data, memberUid) {
      return data.keys().hasAll([
          'uid', 'staffId', 'displayName', 'roleId', 'assignedStoreIds',
          'permissions', 'isActive', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'staffId', 'displayName', 'roleId', 'assignedStoreIds',
          'permissions', 'isActive', 'ownerUid', 'memberUids', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == memberUid &&
        data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.roleId is string && data.roleId.size() >= 1 && data.roleId.size() <= 64 &&
        data.assignedStoreIds is list && data.assignedStoreIds.size() <= 20 && (data.assignedStoreIds.size() == 0 || data.assignedStoreIds[0] is string) &&
        data.permissions is list && data.permissions.size() <= 30 && (data.permissions.size() == 0 || data.permissions[0] is string) &&
        data.isActive is bool &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 && data.memberUids[0] is string;
    }

    function isValidPrivateSettingsBase(data, docId) {
      return data.keys().hasAll(['id', 'integrations', 'ownerUid', 'adminUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'integrations', 'ownerUid', 'adminUids', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.id == docId &&
        data.integrations is map &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 20 && data.adminUids[0] is string;
    }

    function isValidStore(data, storeId, isCreate) {
      return data.keys().hasAll([
          'id', 'name', 'address', 'phone', 'isActive', 'defaultWarehouseId',
          'storeId', 'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'address', 'phone', 'isActive', 'defaultWarehouseId',
          'storeCode', 'color', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == storeId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.isActive is bool &&
        data.defaultWarehouseId is string && data.defaultWarehouseId.size() <= 128 &&
        (!('storeCode' in data) || (data.storeCode is string && data.storeCode.size() <= 20)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidWarehouse(data, warehouseId, isCreate) {
      return data.keys().hasAll([
          'id', 'name', 'address', 'isMain', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'address', 'isMain', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == warehouseId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.isMain is bool &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidCategory(data, categoryId, isCreate) {
      return data.keys().hasAll([
          'id', 'nameUz', 'nameRu', 'sortOrder', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'nameUz', 'nameRu', 'parentId', 'sortOrder', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == categoryId &&
        data.nameUz is string && data.nameUz.size() >= 1 && data.nameUz.size() <= 120 &&
        data.nameRu is string && data.nameRu.size() >= 1 && data.nameRu.size() <= 120 &&
        (!('parentId' in data) || (data.parentId is string && data.parentId.size() <= 128)) &&
        data.sortOrder is number &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidBrand(data, brandId, isCreate) {
      return data.keys().hasAll([
          'id', 'name', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'country', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == brandId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidProduct(data, productId, isCreate) {
      return data.keys().hasAll([
          'id', 'name', 'categoryId', 'unit', 'tags', 'isPublishedOnline',
          'variants', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'categoryId', 'brandId', 'collection', 'unit',
          'description', 'photoUrl', 'supplierId', 'tags', 'isPublishedOnline',
          'variants', 'storeId', 'ownerUid', 'memberUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == productId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 &&
        (!('brandId' in data) || (data.brandId is string && data.brandId.size() <= 128)) &&
        (!('collection' in data) || (data.collection is string && data.collection.size() <= 120)) &&
        data.unit in ['dona', 'juft', 'kg', 'litr', 'quti', 'metr'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 150000)) &&
        (!('supplierId' in data) || (data.supplierId is string && data.supplierId.size() <= 128)) &&
        data.tags is list && data.tags.size() <= 30 && (data.tags.size() == 0 || data.tags[0] is string) &&
        data.isPublishedOnline is bool &&
        data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 50 && data.variants[0] is map &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidSupplier(data, supplierId, isCreate) {
      return data.keys().hasAll([
          'id', 'name', 'contactName', 'phone', 'debtBalance', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'contactName', 'phone', 'address', 'notes', 'debtBalance',
          'storeId', 'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == supplierId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.contactName is string && data.contactName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.debtBalance is number &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidStockItem(data, stockItemId, isCreate) {
      return data.keys().hasAll([
          'id', 'productId', 'variantId', 'warehouseId', 'qty', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'productId', 'variantId', 'warehouseId', 'qty', 'storeId',
          'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == stockItemId &&
        data.productId is string && data.productId.size() <= 128 &&
        data.variantId is string && data.variantId.size() <= 128 &&
        data.warehouseId is string && data.warehouseId.size() <= 128 &&
        data.qty is number &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidStockMovement(data, movementId, isCreate) {
      return data.keys().hasAll([
          'id', 'productId', 'variantId', 'warehouseId', 'type', 'qtyDelta',
          'qtyAfter', 'unitCost', 'storeId', 'ownerUid', 'memberUids',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'productId', 'variantId', 'warehouseId', 'type', 'qtyDelta',
          'qtyAfter', 'unitCost', 'referenceId', 'referenceType', 'note',
          'storeId', 'ownerUid', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.id == movementId &&
        data.productId is string && data.productId.size() <= 128 &&
        data.variantId is string && data.variantId.size() <= 128 &&
        data.warehouseId is string && data.warehouseId.size() <= 128 &&
        data.type is string && data.type.size() <= 40 &&
        data.qtyDelta is number &&
        data.qtyAfter is number &&
        data.unitCost is number &&
        (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
        (!('referenceType' in data) || (data.referenceType is string && data.referenceType.size() <= 64)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        hasValidStoreId(data) &&
        (isCreate ? hasTenantFields(data) : hasTenantFieldsUpdate(data));
    }

    function isValidPurchaseReceipt(data, receiptId, isCreate) {
      return data.keys().hasAll([
