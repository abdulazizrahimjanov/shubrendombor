          isValidWriteOff(incoming(), writeOffId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(writeOffId) &&
          isValidWriteOff(incoming(), writeOffId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(writeOffId) && isWsAdmin(workspaceId);
      }

      match /stocktakes/{stocktakeId} {
        allow get: if canGetWorkspaceDoc(workspaceId, stocktakeId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(stocktakeId) &&
          isValidStocktake(incoming(), stocktakeId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(stocktakeId) &&
          isValidStocktake(incoming(), stocktakeId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status == 'in_progress' &&
              hasMemberPerm(workspaceId, 'manage_stock') &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'totalDiscrepancyValue', 'note', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(stocktakeId) && isWsAdmin(workspaceId);
      }

      // 6f. POS Sales, Returns, Cash Shifts (Shared Warehouse & Universal Active-Staff Sales)
      match /sales/{saleId} {
        allow get: if canGetWorkspaceDoc(workspaceId, saleId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(saleId) &&
          isValidSale(incoming(), saleId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(saleId) &&
          isValidSale(incoming(), saleId, false) &&
          isActiveWsMember(workspaceId) && (
            // Action: Any active staff settles deferred check
            (
              existing().status == 'deferred' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'payments', 'paidAmount', 'debtAmount', 'cashGiven', 'changeAmount',
                'paidAt', 'customerId', 'customerName', 'loyaltyPointsSpent', 'loyaltyPointsEarned',
                'totalAmount', 'vatAmount', 'shiftId', 'cashierId', 'cashierName', 'offlineCreated', 'syncedAt', 'updatedAt'
              ])
            ) ||
            // Action: Authorized staff records sale return
            (
              existing().status in ['completed', 'partial_return'] &&
              hasMemberPerm(workspaceId, 'refund') &&
              incoming().status in ['returned', 'partial_return'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(saleId) && isActiveWsMember(workspaceId) && (
          existing().status == 'deferred' || isWsAdmin(workspaceId)
        );
      }

      match /returns/{returnId} {
        allow get: if canGetWorkspaceDoc(workspaceId, returnId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(returnId) &&
          isValidReturnDoc(incoming(), returnId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'refund');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(returnId) &&
          isValidReturnDoc(incoming(), returnId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(returnId) && isWsAdmin(workspaceId);
      }

      match /cashShifts/{shiftId} {
        allow get: if canGetWorkspaceDoc(workspaceId, shiftId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(shiftId) &&
          isValidCashShift(incoming(), shiftId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(shiftId) &&
          isValidCashShift(incoming(), shiftId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status == 'open' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'closedAt', 'cashSalesTotal', 'cardSalesTotal', 'otherSalesTotal',
                'cashRefundsTotal', 'cashInTotal', 'cashOutTotal', 'expectedCash',
                'actualCash', 'discrepancy', 'status', 'notes', 'updatedAt'
              ])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(shiftId) && isWsAdmin(workspaceId);
      }

      match /cashOperations/{opId} {
        allow get: if canGetWorkspaceDoc(workspaceId, opId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(opId) &&
          isValidCashOperation(incoming(), opId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(opId) &&
          isValidCashOperation(incoming(), opId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(opId) && isWsAdmin(workspaceId);
      }

      // 6g. Finance
      match /accounts/{accountId} {
        allow get: if canGetWorkspaceDoc(workspaceId, accountId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(accountId) &&
          isValidAccount(incoming(), accountId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(accountId) &&
          isValidAccount(incoming(), accountId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              (hasMemberPerm(workspaceId, 'manage_finance') || hasMemberPerm(workspaceId, 'refund') || hasMemberPerm(workspaceId, 'manage_stock')) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'name', 'type', 'isDefault', 'updatedAt'])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']) ||
            isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(accountId) && isWsAdmin(workspaceId);
      }

      match /transactions/{trxId} {
        allow get: if canGetWorkspaceDoc(workspaceId, trxId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(trxId) &&
          isValidFinanceTransaction(incoming(), trxId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(trxId) &&
          isValidFinanceTransaction(incoming(), trxId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(trxId) && isWsAdmin(workspaceId);
      }

      match /expenses/{expId} {
        allow get: if canGetWorkspaceDoc(workspaceId, expId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(expId) &&
          isValidExpense(incoming(), expId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_finance');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(expId) &&
          isValidExpense(incoming(), expId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'accountId', 'category', 'amount', 'description', 'isRecurring', 'recurringDay', 'date', 'memberUids', 'updatedAt'
          ]);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(expId) && isWsAdmin(workspaceId);
      }

      // 6h. CRM, Loyalty, Debts, Promos
      match /customers/{customerId} {
        allow get: if canGetWorkspaceDoc(workspaceId, customerId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(customerId) &&
          isValidCustomer(incoming(), customerId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(customerId) &&
          isValidCustomer(incoming(), customerId, false) &&
          isActiveWsMember(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'birthday', 'gender', 'notes', 'tags', 'segment',
              'totalSpent', 'ordersCount', 'lastPurchaseAt', 'debtBalance', 'updatedAt'
            ]) ||
            isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(customerId) && isWsAdmin(workspaceId);
      }

      match /loyaltyAccounts/{loyId} {
        allow get: if canGetWorkspaceDoc(workspaceId, loyId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(loyId) &&
          isValidLoyaltyAccount(incoming(), loyId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(loyId) &&
          isValidLoyaltyAccount(incoming(), loyId, false) &&
          isActiveWsMember(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['tier', 'cashbackPercent', 'pointsBalance', 'expiresAt', 'updatedAt']) ||
            isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(loyId) && isWsAdmin(workspaceId);
      }

      match /loyaltyTransactions/{ltxId} {
        allow get: if canGetWorkspaceDoc(workspaceId, ltxId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(ltxId) &&
          isValidLoyaltyTransaction(incoming(), ltxId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(ltxId) &&
          isValidLoyaltyTransaction(incoming(), ltxId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(ltxId) && isWsAdmin(workspaceId);
      }

      match /debts/{debtId} {
        allow get: if canGetWorkspaceDoc(workspaceId, debtId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(debtId) &&
          isValidDebt(incoming(), debtId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(debtId) &&
          isValidDebt(incoming(), debtId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status != 'paid' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['remainingAmount', 'status', 'payments', 'dueDate', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(debtId) && isWsAdmin(workspaceId);
      }

      match /promoCodes/{promoId} {
        allow get: if canGetWorkspaceDoc(workspaceId, promoId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(promoId) &&
          isValidPromoCode(incoming(), promoId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_marketing');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(promoId) &&
          isValidPromoCode(incoming(), promoId, false) &&
          isActiveWsMember(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt']) ||
            (
              hasMemberPerm(workspaceId, 'manage_marketing') &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'code', 'discountType', 'discountValue', 'minOrderAmount', 'maxUses', 'usedCount', 'expiresAt', 'isActive', 'updatedAt'
              ])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(promoId) && isWsAdmin(workspaceId);
      }

      // 6i. Staff Directory (Non-PII) & Isolated Staff Credentials (Admin-Only PII + Hashed Credentials)
      match /staffDirectory/{staffId} {
        allow get: if canGetWorkspaceDoc(workspaceId, staffId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(staffId) &&
          isValidStaffDirectoryEntry(incoming(), staffId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsAdmin(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(staffId) &&
          isValidStaffDirectoryEntry(incoming(), staffId, false) &&
          isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'roleId', 'assignedStoreIds', 'customPermissions', 'isActive',
              'avatarColor', 'schedule', 'storeId', 'memberUids', 'updatedAt'
            ])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(staffId) && isWsAdmin(workspaceId);
      }

      match /staffCredentials/{staffId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(staffId) && isWsAdminRead(workspaceId);
        allow list: if canReadAdminRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(staffId) &&
          isValidStaffCredential(incoming(), staffId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isWsAdmin(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(staffId) &&
          isValidStaffCredential(incoming(), staffId, false) &&
          isWsAdmin(workspaceId) &&
          (!('password' in incoming()) || ('password' in existing() && incoming().password == existing().password)) &&
          (!('pin' in incoming()) || ('pin' in existing() && incoming().pin == existing().pin)) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phone', 'passwordHash', 'pinHash', 'hashAlgo', 'authMigrated',
              'googleEmail', 'baseSalary', 'commissionPercent', 'hiredAt',
              'storeId', 'adminUids', 'updatedAt'
            ]) ||
            (
              ('passwordHash' in incoming() || 'pinHash' in incoming() || incoming().authMigrated == true) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'password', 'pin', 'passwordHash', 'pinHash', 'hashAlgo', 'authMigrated', 'updatedAt'
              ]) &&
              !('password' in incoming()) &&
              !('pin' in incoming())
            )
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(staffId) && isWsAdmin(workspaceId);
      }

      match /staffInvites/{inviteId} {
        allow get: if isVerified() && isValidId(workspaceId) && isValidId(inviteId) && (
          isWsAdminRead(workspaceId) ||
          (
            isWsMemberRead(workspaceId) &&
            'email' in request.auth.token &&
            request.auth.token.email is string &&
            inviteId == authEmailSha256()
          )
        );
        allow list: if canReadAdminRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(inviteId) &&
          isValidStaffInvite(incoming(), inviteId, true) &&
          hasAdminTenantFieldsForWs(incoming(), workspaceId) &&
          isWsAdmin(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(inviteId) &&
          isValidStaffInvite(incoming(), inviteId, false) &&
          isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'staffId', 'userId', 'roleId', 'assignedStoreIds', 'permissions', 'adminUids', 'updatedAt'
            ])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(inviteId) && isWsAdmin(workspaceId);
      }

      match /targets/{targetId} {
        allow get: if canGetWorkspaceDoc(workspaceId, targetId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(targetId) &&
          isValidTarget(incoming(), targetId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_employees');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(targetId) &&
          isValidTarget(incoming(), targetId, false) &&
          isWsAdmin(workspaceId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['employeeId', 'month', 'targetAmount', 'memberUids', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(targetId) && isWsAdmin(workspaceId);
      }

      // 6j. Online Orders, Audit Logs & Idempotent Offline Sync Markers
      match /onlineOrders/{orderId} {
        allow get: if canGetWorkspaceDoc(workspaceId, orderId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(orderId) &&
          isValidOnlineOrder(incoming(), orderId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(orderId) &&
          isValidOnlineOrder(incoming(), orderId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status in ['new', 'confirmed'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(orderId) && isWsAdmin(workspaceId);
      }

      match /auditLogs/{auditId} {
        allow get: if canGetWorkspaceDoc(workspaceId, auditId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(auditId) &&
          isValidAuditLog(incoming(), auditId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(auditId) &&
          isValidAuditLog(incoming(), auditId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if false;
      }

      match /syncedOps/{opId} {
        allow get: if canGetWorkspaceDoc(workspaceId, opId);
        allow list: if canReadWorkspaceRow(workspaceId, resource.data);
        allow create: if isVerified() && isValidId(workspaceId) && isValidId(opId) &&
          isValidSyncedOp(incoming(), opId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId);
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(opId) &&
          isValidSyncedOp(incoming(), opId, false) &&
          isWsAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
