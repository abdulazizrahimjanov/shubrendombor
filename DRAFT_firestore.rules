        allow create: if isVerified() && isValidId(workspaceId) && isValidId(poId) &&
          isValidPurchaseOrder(incoming(), poId, true) &&
          incoming().ownerUid == wsDoc(workspaceId).data.ownerUid &&
          isActiveWsMember(workspaceId) &&
          hasMemberPerm(workspaceId, 'manage_stock');
        allow update: if isVerified() && isValidId(workspaceId) && isValidId(poId) &&
          isValidPurchaseOrder(incoming(), poId, false) &&
          isActiveWsMember(workspaceId) && (
            (
              existing().status in ['draft', 'ordered'] &&
              hasMemberPerm(workspaceId, 'manage_stock') &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'totalAmount', 'expectedDate', 'note', 'updatedAt'])
            ) || isWsAdmin(workspaceId)
          );
        allow delete: if isVerified() && isValidId(workspaceId) && isValidId(poId) && isWsAdmin(workspaceId);
